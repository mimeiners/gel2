\input{../../common/tikz-prefix.tex}

% =============================================================================

\begin{document}

\begin{tikzpicture}[xscale=1,yscale=1.5]
  \newcommand{\alphaa}{60 * pi / 180}
  \newcommand{\betaa}{180 * pi / 180}
  
  % axis
  \draw[thin, ->] (0, -1.2) -- (0, 1.2) node[left] {$i(t)$};
  \draw[thin, ->] (-0.2, 0) -- (4.1*pi,0) node[right] {$\omega t$};
  
  % tick labels
  \foreach \x/\xtext in {0,{\alphaa}/\alpha,{pi}/\pi,{\betaa}/~,{2*pi}/{2\pi},{3*pi}/{3\pi},{4*pi}/{4\pi}}
  \draw (\x,0.1) -- (\x,-0.1) node [below] {$\xtext$};
  % \draw (\betaa,-0.1) -- (\betaa,0.1) node [above] {$\beta$};
  
  % Vs
  \draw[domain=0:4*pi, help lines, smooth] plot (\x,{sin(\x r)});
  % -Vs
  % \draw[domain=0:2*pi, help lines, smooth] plot (\x,{-sin(\x r)});
  % Vo and Io
  \foreach \qq [evaluate=\qq as \qqshft using \qq*pi] in {0,2}
  {%
    \begin{scope}[xshift=\qqshft cm, every path/.style={color=red,thick}]
      % Vo
      \draw 
      [domain=0:{\betaa-pi}] plot (\x,{-sin(\x r)}) -- ({\betaa-pi},0) -| (\alphaa,{sin(\alphaa r)})
      [domain=\alphaa:pi] plot (\x,{sin(\x r)}) -- (pi+\alphaa,0) -| (pi+\alphaa,{-sin(pi+\alphaa r)})
      [domain=pi+\alphaa:2*pi] plot (\x, {sin(\x r)});
    \end{scope}
  }
\end{tikzpicture}

\end{document}
